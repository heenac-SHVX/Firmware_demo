<?php

// Always return JSON
header('Content-Type: application/json');

// Backend API base URL. Set IMMUTAVERSE_API_BASE to point at another backend (e.g. an ngrok URL for testing).
define('IMMUTAVERSE_API_BASE', rtrim(getenv('IMMUTAVERSE_API_BASE') ?: 'https://app.immutaverse.com', '/'));

// Mixpanel project token (public; the same token is in the website JavaScript). EU data residency endpoint.
define('MIXPANEL_TOKEN', getenv('MIXPANEL_TOKEN') ?: '1f9edbe5687f55b717c06d4d7b1bbd72');
define('MIXPANEL_API_HOST', 'https://api-eu.mixpanel.com');

// Helper: send response and exit
function respond($statusCode, $message, $extra = []) {
    http_response_code($statusCode);
    echo json_encode(array_merge([
        "status" => $statusCode < 400 ? "success" : "error",
        "message" => $message
    ], $extra));
    exit;
}

// Helper: validate string
function isValidString($value) {
    return isset($value) && is_string($value) && trim($value) !== '';
}

/**
 * Resolve GitHub user email from PAT token.
 *
 * @param string $patToken  Raw PAT token (without "Bearer " prefix)
 * @return string|null      The user's email, or null if not found
 */
function resolveGitHubEmail($patToken) {
    error_log("SIGN_DEBUG: Resolving GitHub email from PAT...");

    $context = stream_context_create([
        'http' => [
            'method'  => 'GET',
            'header'  => "Authorization: token $patToken\r\nUser-Agent: Immutaverse-SignRequest\r\n",
            'timeout' => 10,
            'ignore_errors' => true,
        ],
    ]);

    // Try /user endpoint first (returns primary email if public)
    $userBody = @file_get_contents('https://api.github.com/user', false, $context);
    if ($userBody === false) {
        error_log("SIGN_DEBUG: Could not reach GitHub /user API");
        return null;
    }

    $userData = json_decode($userBody, true);
    if (isset($userData['email']) && !empty($userData['email'])) {
        error_log("SIGN_DEBUG: Got email from /user: " . $userData['email']);
        return $userData['email'];
    }

    // If /user didn't return an email, try /user/emails (requires user:email scope)
    $emailsBody = @file_get_contents('https://api.github.com/user/emails', false, $context);
    if ($emailsBody === false) {
        error_log("SIGN_DEBUG: Could not reach GitHub /user/emails API");
        return null;
    }

    $emails = json_decode($emailsBody, true);
    if (is_array($emails)) {
        // Prefer the primary email
        foreach ($emails as $entry) {
            if (!empty($entry['primary']) && !empty($entry['email'])) {
                error_log("SIGN_DEBUG: Got primary email from /user/emails: " . $entry['email']);
                return $entry['email'];
            }
        }
        // Fallback: first verified email
        foreach ($emails as $entry) {
            if (!empty($entry['verified']) && !empty($entry['email'])) {
                error_log("SIGN_DEBUG: Got verified email from /user/emails: " . $entry['email']);
                return $entry['email'];
            }
        }
    }

    error_log("SIGN_DEBUG: Could not resolve any email from GitHub");
    return null;
}

/**
 * Send failure notification email via the Node.js API.
 *
 * @param string $patToken      Raw PAT token
 * @param string $errorCode     e.g. VERSION_MISMATCH, SUBSCRIPTION_INACTIVE, API_ERROR
 * @param string $errorMessage  Human-readable error message
 * @param string $repo          Repository name
 * @param string $branch        Branch name
 */
function sendFailureEmail($patToken, $errorCode, $errorMessage, $repo, $branch) {
    $email = resolveGitHubEmail($patToken);

    if (!$email) {
        error_log("SIGN_DEBUG: Skipping failure email — could not resolve user email");
        return;
    }

    error_log("SIGN_DEBUG: Sending failure email to $email (error_code=$errorCode)");

    $payload = json_encode([
        'email'         => $email,
        'error_code'    => $errorCode,
        'error_message' => $errorMessage,
        'repo'          => $repo,
        'branch'        => $branch,
    ]);

    $context = stream_context_create([
        'http' => [
            'method'  => 'POST',
            'header'  => "Content-Type: application/json\r\n",
            'content' => $payload,
            'timeout' => 10,
            'ignore_errors' => true,
        ],
    ]);

    $result = @file_get_contents(IMMUTAVERSE_API_BASE . '/api/v1/notify/failure-email', false, $context);

    if ($result === false) {
        error_log("SIGN_DEBUG: Failed to call failure-email API");
    } else {
        error_log("SIGN_DEBUG: Failure email API response: $result");
    }
}

/**
 * Respond with error AND send failure notification email, then exit.
 *
 * @param int    $statusCode
 * @param string $message
 * @param string $errorCode
 * @param string $rawToken      Raw PAT token (no "Bearer " prefix)
 * @param string $repo
 * @param string $branch
 * @param array  $extra         Additional fields for the JSON response
 */
function respondWithEmail($statusCode, $message, $errorCode, $rawToken, $repo, $branch, $extra = []) {
    // Fire the email (non-blocking best-effort)
    sendFailureEmail($rawToken, $errorCode, $message, $repo, $branch);

    // Then respond to the caller
    respond($statusCode, $message, array_merge(['error_code' => $errorCode], $extra));
}

/**
 * Server-side subscription & version check.
 *
 * @param string $patToken       The full Authorization header value ("Bearer xxx")
 * @param string $version        The action version sent by the client
 * @param string $repo           Repo name (for email context)
 * @param string $branch         Branch name (for email context)
 * @return array                 Parsed check-subscription response (includes firebase_uid when known).
 *                               On any failure this function responds and exits instead of returning.
 */
function verifySubscription($patToken, $version, $repo, $branch) {
    error_log("SIGN_DEBUG: verifySubscription() called with version=$version");

    $rawToken = preg_replace('/^Bearer\s+/', '', $patToken);

    $payload = json_encode([
        'pat_token' => $rawToken,
        'version'   => $version,
    ]);

    error_log("SIGN_DEBUG: Calling check-subscription API...");

    $context = stream_context_create([
        'http' => [
            'method'  => 'POST',
            'header'  => "Content-Type: application/json\r\n",
            'content' => $payload,
            'timeout' => 15,
            'ignore_errors' => true,
        ],
    ]);

    $responseBody = @file_get_contents(IMMUTAVERSE_API_BASE . '/api/v1/stripe/check-subscription', false, $context);

    $httpCode = 0;
    if (isset($http_response_header) && is_array($http_response_header)) {
        foreach ($http_response_header as $header) {
            if (preg_match('/^HTTP\/\S+\s+(\d+)/', $header, $matches)) {
                $httpCode = (int) $matches[1];
            }
        }
    }

    error_log("SIGN_DEBUG: Subscription API responded HTTP=$httpCode");
    error_log("SIGN_DEBUG: Subscription API body=$responseBody");

    // Network failure
    if ($responseBody === false) {
        error_log("Subscription check failed: could not reach API");
        respondWithEmail(502, "Unable to verify subscription (upstream unreachable)", "API_UNREACHABLE", $rawToken, $repo, $branch);
    }

    // Non-200 from subscription API
    if ($httpCode !== 200) {
        error_log("Subscription check HTTP $httpCode: $responseBody");
        respondWithEmail(502, "Unable to verify subscription status (HTTP $httpCode)", "API_ERROR", $rawToken, $repo, $branch);
    }

    $data = json_decode($responseBody, true);
    if (json_last_error() !== JSON_ERROR_NONE) {
        error_log("Subscription check returned invalid JSON: $responseBody");
        respondWithEmail(502, "Invalid response from subscription service", "API_INVALID_RESPONSE", $rawToken, $repo, $branch);
    }

    error_log("SIGN_DEBUG: Parsed subscription data: " . print_r($data, true));

    // ---- Version mismatch ----
    $versionOk  = $data['version_ok']  ?? false;
    $errorCode  = $data['error_code']  ?? null;

    if ($errorCode === 'VERSION_MISMATCH' || $versionOk != true) {
        error_log("SIGN_DEBUG: Version check FAILED. version_ok=$versionOk error_code=$errorCode");
        respondWithEmail(
            409,
            "Action version mismatch. Please update your workflow to the latest version from the Immutaverse GitHub repo.",
            "VERSION_MISMATCH",
            $rawToken, $repo, $branch
        );
    }

    // ---- Subscription not active ----
    $success = $data['success'] ?? false;
    $active  = $data['active']  ?? false;

    if ($success != true || $active != true) {
        error_log("SIGN_DEBUG: Subscription INACTIVE. success=$success active=$active");
        respondWithEmail(
            403,
            "Subscription is not active. Please check your billing.",
            "SUBSCRIPTION_INACTIVE",
            $rawToken, $repo, $branch
        );
    }

    error_log("SIGN_DEBUG: Subscription verified OK");
    return $data;
}

/**
 * Send one event to Mixpanel. Best-effort: never throws, never blocks signing for long.
 *
 * @param string $event       Event name
 * @param string $distinctId  Firebase UID (same ID the website uses in mixpanel.identify)
 * @param array  $properties  Event properties
 * @param string $insertId    Dedup key (max 36 chars, letters/digits/"-")
 * @return bool               true if Mixpanel accepted the event
 */
function trackMixpanelEvent($event, $distinctId, $properties, $insertId) {
    if (!MIXPANEL_TOKEN) {
        error_log("SIGN_DEBUG: Mixpanel token not set, skipping \"$event\"");
        return false;
    }
    if (!isValidString($distinctId)) {
        error_log("SIGN_DEBUG: No firebase_uid, skipping Mixpanel \"$event\"");
        return false;
    }

    $payload = json_encode([[
        'event'      => $event,
        'properties' => array_merge($properties, [
            'token'       => MIXPANEL_TOKEN,
            'distinct_id' => $distinctId,
            'time'        => time(),
            '$insert_id'  => substr(preg_replace('/[^A-Za-z0-9-]/', '-', $insertId), 0, 36),
            'source'      => 'signing_server',
        ]),
    ]]);

    $context = stream_context_create([
        'http' => [
            'method'  => 'POST',
            'header'  => "Content-Type: application/json\r\nAccept: application/json\r\n",
            'content' => $payload,
            'timeout' => 5,
            'ignore_errors' => true,
        ],
    ]);

    // ip=0: do not geolocate the event from the server's IP address.
    $result = @file_get_contents(MIXPANEL_API_HOST . '/track?ip=0&verbose=1', false, $context);
    $decoded = $result === false ? null : json_decode($result, true);

    if (($decoded['status'] ?? 0) !== 1) {
        error_log("SIGN_DEBUG: Mixpanel \"$event\" failed: " . ($result === false ? 'unreachable' : $result));
        return false;
    }
    error_log("SIGN_DEBUG: Mixpanel \"$event\" sent for $distinctId");
    return true;
}

// ========================================================================
// Main request handling
// ========================================================================
try {
    error_log("SIGN_DEBUG: === signRequest.php START ===");

    // ---- HEADERS ----
    $headers = getallheaders();
    $authHeader = $headers['Authorization'] ?? null;

    if (!isValidString($authHeader)) {
        respond(401, "Missing or invalid Authorization header");
    }

    if (!preg_match('/^Bearer\s+\S+$/', $authHeader)) {
        respond(401, "Invalid Authorization format");
    }

    // ---- BODY ----
    $rawBody = file_get_contents("php://input");

    if (!isValidString($rawBody)) {
        respond(400, "Empty request body");
    }

    $bodyData = json_decode($rawBody, true);

    if (json_last_error() !== JSON_ERROR_NONE) {
        respond(400, "Invalid JSON payload");
    }

    error_log("SIGN_DEBUG: Body parsed OK, keys=" . implode(',', array_keys($bodyData)));

    // ---- REQUIRED FIELDS ----
    $requiredFields = ['repo', 'branch', 'commit', 'file', 'key', 'action_version'];

    foreach ($requiredFields as $field) {
        if (!isset($bodyData[$field]) || !isValidString($bodyData[$field])) {
            error_log("SIGN_DEBUG: Missing/invalid field: $field");
            respond(422, "Missing or invalid field: $field");
        }
    }

    $repo           = trim($bodyData['repo']);
    $branch         = trim($bodyData['branch']);
    $commit         = trim($bodyData['commit']);
    $file           = trim($bodyData['file']);
    $key            = trim($bodyData['key']);
    $actionVersion  = trim($bodyData['action_version']);

    error_log("SIGN_DEBUG: Fields extracted. repo=$repo branch=$branch actionVersion=$actionVersion");

    // ---- EXTRA HARDENING ----
    if (!preg_match('/^[a-zA-Z0-9._\-\/]+$/', $repo)) {
        respond(422, "Invalid repo format");
    }

    if (!preg_match('/^[a-zA-Z0-9._\-]+$/', $branch)) {
        respond(422, "Invalid branch format");
    }

    if (!preg_match('/^\d+\.\d+\.\d+$/', $actionVersion)) {
        respond(422, "Invalid action_version format");
    }

    error_log("SIGN_DEBUG: Validation passed, calling verifySubscription...");

    // ================================================================
    // SERVER-SIDE SUBSCRIPTION CHECK (now sends email on failure)
    // ================================================================
    $subscription = verifySubscription($authHeader, $actionVersion, $repo, $branch);

    error_log("SIGN_DEBUG: Subscription check passed, executing command...");

    // ---- ESCAPE FOR SHELL ----
    $authHeaderEscaped = escapeshellarg($authHeader);
    $repoEscaped       = escapeshellarg($repo);
    $branchEscaped     = escapeshellarg($branch);
    $commitEscaped     = escapeshellarg($commit);
    $fileEscaped       = escapeshellarg($file);
    $keyEscaped        = escapeshellarg($key);

    // ---- COMMAND ----
    $command = "/var/www/html/run1.sh $authHeaderEscaped $repoEscaped $fileEscaped $commitEscaped $keyEscaped 2>&1 &";

    error_log("SIGN_DEBUG: Running shell command (secrets redacted)");

    $output = shell_exec($command);

    error_log("SIGN_DEBUG: shell_exec returned: " . ($output === null ? "NULL" : $output));
    error_log("Webhook executed for repo={$repo}, branch={$branch}");

    // ---- MIXPANEL: Firmware Signed ----
    // run1.sh runs in the background, so this fires when signing is started, not when it finishes.
    // Same repo + commit gives the same $insert_id, so a retried request is not counted twice.
    // Never send $commit, $file, $key or the PAT as properties (customer IP / secrets, see tracking plan).
    trackMixpanelEvent(
        'Firmware Signed',
        $subscription['firebase_uid'] ?? null,
        [
            'repo'           => $repo,
            'branch'         => $branch,
            'action_version' => $actionVersion,
            'github_handle'  => $subscription['github_handle'] ?? null,
        ],
        md5($repo . '|' . $commit)
    );

    respond(200, "Command triggered successfully");

} catch (Throwable $e) {
    error_log("SIGN_DEBUG ERROR: " . $e->getMessage() . " in " . $e->getFile() . ":" . $e->getLine());
    error_log("SIGN_DEBUG TRACE: " . $e->getTraceAsString());

    // Try to send email even on unexpected errors (best-effort)
    $rawToken = isset($authHeader) ? preg_replace('/^Bearer\s+/', '', $authHeader) : null;
    if ($rawToken && isset($repo) && isset($branch)) {
        sendFailureEmail($rawToken, "INTERNAL_ERROR", $e->getMessage(), $repo, $branch);
    }

    respond(500, "Internal server error");
}
